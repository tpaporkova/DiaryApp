<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.diaryapp.ui.home.HomeFragment"
        android:label="Дневник влюбленных"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_editMomentFragment"
            app:destination="@id/editMomentFragment">
            <argument
                android:name="momentId"
                app:argType="integer" />
        </action>

        <action
            android:id="@+id/action_homeFragment_to_momentListFragment"
            app:destination="@id/momentListFragment" />

        <action
            android:id="@+id/action_homeFragment_to_statsFragment"
            app:destination="@id/statsFragment" />
    </fragment>

    <fragment
        android:id="@+id/momentListFragment"
        android:name="com.example.diaryapp.ui.moment.MomentListFragment"
        android:label="Список моментов"
        tools:layout="@layout/fragment_moment_list">
        <action
            android:id="@+id/action_momentList_to_editMoment"
            app:destination="@id/editMomentFragment">
            <argument
                android:name="momentId"
                app:argType="integer" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/editMomentFragment"
        android:name="com.example.diaryapp.ui.moment.EditMomentFragment"
        android:label="Редактировать момент"
        tools:layout="@layout/fragment_edit_moment">
        <argument
            android:name="momentId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.diaryapp.ui.stats.StatsFragment"
        android:label="Статистика моментов"
        tools:layout="@layout/fragment_stats"
        tools:targetApi="26" />

</navigation>
